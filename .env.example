# Which LLM provider to use for the fallback: "anthropic" (default) or "groq".
LLM_PROVIDER=anthropic

# --- Anthropic Claude (default provider) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq (alternative provider) ---
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Port for the backend proxy (frontend dev server proxies /api here)
PORT=3001
